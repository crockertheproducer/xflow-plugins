# Las imágenes subidas nunca se ejecutan como código.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .phar
RemoveType .php .phtml .php5 .php7 .phar
<FilesMatch "\.(php|phtml|php5|php7|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
